---
import { 
  House, 
  List, 
  Plus, 
  ChartLineUp, 
  ListDashes 
} from 'phosphor-svelte';

const currentPath = Astro.url.pathname;

const links = [
  { name: 'Home', href: '/app', icon: House, exact: true },
  { name: 'Transactions', href: '/app/transactions', icon: List, exact: false },
];

const secondaryLinks = [
  { name: 'Insights', href: '/app/insights', icon: ChartLineUp, exact: false },
  { name: 'More', href: '/app/settings', icon: ListDashes, exact: false }, // Could be a drawer, but settings works for now
];
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 bg-surface border-t border-border flex items-center justify-around px-2 pb-safe pt-1 z-50">
  {links.map((link) => {
    const isActive = link.exact ? currentPath === link.href : currentPath.startsWith(link.href);
    const Icon = link.icon;
    return (
      <a href={link.href} class="flex flex-col items-center justify-center w-16 h-14 text-text-muted hover:text-text-main transition-colors">
        <Icon size={24} weight={isActive ? "fill" : "regular"} class={isActive ? "text-accent mb-0.5" : "mb-0.5"} />
        <span class:list={["text-[10px] font-medium", isActive ? "text-text-main" : "text-text-muted"]}>{link.name}</span>
      </a>
    )
  })}

  <!-- Fast Add Transaction Button -->
  <a href="/app/transactions/new" class="flex items-center justify-center w-12 h-12 -mt-4 rounded-full bg-accent text-white shadow-sm hover:bg-accent-hover transition-transform active:scale-95">
    <Plus size={24} weight="bold" />
  </a>

  {secondaryLinks.map((link) => {
    const isActive = link.exact ? currentPath === link.href : currentPath.startsWith(link.href);
    const Icon = link.icon;
    return (
      <a href={link.href} class="flex flex-col items-center justify-center w-16 h-14 text-text-muted hover:text-text-main transition-colors">
        <Icon size={24} weight={isActive ? "fill" : "regular"} class={isActive ? "text-accent mb-0.5" : "mb-0.5"} />
        <span class:list={["text-[10px] font-medium", isActive ? "text-text-main" : "text-text-muted"]}>{link.name}</span>
      </a>
    )
  })}
</nav>

<style>
  /* Safe area padding for iOS */
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>
