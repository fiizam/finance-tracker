---
// src/components/MobileAppSplash.astro
// Renders splash screen on cold mobile/standalone PWA app launches if not already shown in session
---

<div 
  id="app-splash-screen" 
  class="fixed inset-0 bg-[#04471C] flex flex-col items-center justify-center overflow-hidden z-[99999] transition-opacity duration-500 pointer-events-none"
  style="display: none; opacity: 1;"
  aria-hidden="true"
>
  <!-- Background decorative rings matching index.astro -->
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-64 h-64 border border-white rounded-full"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 border border-white rounded-full"></div>
  </div>
  
  <div class="relative z-10 flex flex-col items-center animate-fade-in-up">
    <div class="w-16 h-16 bg-white flex items-center justify-center mb-6 rounded-sm shadow-xl transform rotate-3">
      <span class="text-[#04471C] font-display font-bold text-3xl leading-none tracking-tighter">F</span>
    </div>
    <h1 class="text-white font-display text-4xl tracking-tight font-medium mb-2">Finance</h1>
    <p class="text-white/70 font-sans text-sm tracking-wide uppercase">Your Money Journal</p>
  </div>
</div>

<script>
  (() => {
    // Only run on mobile or standalone PWA
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator as any).standalone === true;
    const isMobile = window.innerWidth <= 768 || isStandalone;
    
    // Check if splash has already been shown in current session
    let splashShown = false;
    try {
      splashShown = sessionStorage.getItem('splash_shown') === 'true';
    } catch (e) {}

    const splash = document.getElementById('app-splash-screen');
    if (splash && isMobile && !splashShown) {
      // Make visible immediately
      splash.style.display = 'flex';
      splash.style.pointerEvents = 'auto';
      try {
        sessionStorage.setItem('splash_shown', 'true');
      } catch (e) {}

      // Fade out smoothly after 1.2s
      setTimeout(() => {
        splash.style.opacity = '0';
        setTimeout(() => {
          splash.style.display = 'none';
        }, 500);
      }, 1200);
    }
  })();
</script>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
