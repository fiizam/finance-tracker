---
import Layout from '../layouts/Layout.astro';
import { db } from '../db';
import { users } from '../db/schema';
import { eq } from 'drizzle-orm';
import bcrypt from 'bcryptjs';

let error = '';
let success = false;
const emailParam = Astro.url.searchParams.get('email') || '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const email = data.get('email')?.toString();
    const otp = data.get('otp')?.toString();
    const password = data.get('password')?.toString();

    if (!email || !otp || !password) {
      error = 'Please fill out all fields.';
    } else {
      const userResult = await db.select().from(users).where(eq(users.email, email)).limit(1);
      const user = userResult[0];

      if (!user) {
        error = 'Invalid verification code.';
      } else if (user.verificationCode !== otp) {
        error = 'Invalid verification code.';
      } else {
        // Validation check (must match frontend validation)
        const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[a-zA-Z\d\w\W]{8,}$/;
        if (!passwordRegex.test(password)) {
          error = 'Password does not meet the security requirements.';
        } else {
          // Hash new password
          const passwordHash = await bcrypt.hash(password, 10);

          // Update user
          await db.update(users).set({ 
            passwordHash,
            verificationCode: null 
          }).where(eq(users.id, user.id));

          success = true;
        }
      }
    }
  } catch (e: any) {
    console.error('Reset password error:', e);
    error = 'Something went wrong. Please try again.';
  }
}
---

<Layout title="New Password">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 page-transition">
    <div class="w-full max-w-sm">
      <div class="mb-12">
        <div class="w-10 h-10 rounded-sm bg-accent flex items-center justify-center mb-6">
          <span class="text-white font-display font-semibold text-lg leading-none tracking-tight">F</span>
        </div>
        <h1 class="text-3xl font-display font-medium text-text-main mb-2 tracking-tight">New Password</h1>
        <p class="text-text-muted text-sm">Enter the code from your email and a new password.</p>
      </div>

      {success ? (
        <div class="bg-green-50 border border-green-100 rounded-md p-6 text-center">
          <div class="text-green-500 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-medium text-text-main mb-1">Password Changed</h3>
          <p class="text-sm text-text-muted mb-4">Your password has been successfully updated.</p>
          <a href="/login" class="inline-block w-full bg-accent text-white rounded-md py-2 text-sm font-medium hover:bg-accent-hover transition-colors shadow-sm">
            Sign In Now
          </a>
        </div>
      ) : (
        <form method="POST" class="space-y-6">
          <input type="hidden" name="email" value={emailParam} />
          
          {error && (
            <div class="bg-red-50 text-red-700 p-3 rounded-md text-sm border border-red-100">
              {error}
            </div>
          )}
          
          <div class="space-y-4">
            <div class="space-y-1.5">
              <label for="otp" class="block text-sm font-medium text-text-main">6-Digit Code</label>
              <input 
                type="text" 
                inputmode="numeric"
                pattern="[0-9]{6}"
                maxlength="6"
                id="otp" 
                name="otp" 
                placeholder="123456"
                required 
                class="w-full px-3 py-3 bg-transparent border border-border rounded-md focus:outline-none focus:border-text-main focus:ring-1 focus:ring-text-main transition-colors text-center text-xl tracking-[0.5em] font-display font-medium text-text-main"
              />
            </div>

            <div class="space-y-1.5 relative">
              <label for="password" class="block text-sm font-medium text-text-main">New Password</label>
              <div class="relative">
                <input 
                  type="password" 
                  id="password" 
                  name="password" 
                  required 
                  class="w-full px-3 py-2 bg-transparent border border-border rounded-md focus:outline-none focus:border-text-main focus:ring-1 focus:ring-text-main transition-colors text-sm pr-10"
                />
                <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 px-3 flex items-center text-text-muted hover:text-text-main transition-colors" tabindex="-1">
                  <!-- Eye Open Icon -->
                  <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <!-- Eye Closed Icon -->
                  <svg id="eye-slash-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                  </svg>
                </button>
              </div>
              <!-- Strength indicators -->
              <div class="mt-2 space-y-1">
                <div class="text-[11px] flex items-center gap-1.5" id="req-length">
                  <div class="w-1 h-1 rounded-full bg-border" id="dot-length"></div>
                  <span class="text-text-muted">Minimum 8 characters</span>
                </div>
                <div class="text-[11px] flex items-center gap-1.5" id="req-upper">
                  <div class="w-1 h-1 rounded-full bg-border" id="dot-upper"></div>
                  <span class="text-text-muted">At least 1 uppercase letter</span>
                </div>
                <div class="text-[11px] flex items-center gap-1.5" id="req-lower">
                  <div class="w-1 h-1 rounded-full bg-border" id="dot-lower"></div>
                  <span class="text-text-muted">At least 1 lowercase letter</span>
                </div>
                <div class="text-[11px] flex items-center gap-1.5" id="req-number">
                  <div class="w-1 h-1 rounded-full bg-border" id="dot-number"></div>
                  <span class="text-text-muted">At least 1 number</span>
                </div>
              </div>
            </div>
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            disabled
            class="w-full bg-accent text-white rounded-md py-2.5 text-sm font-medium hover:bg-accent-hover transition-colors shadow-sm active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Change Password
          </button>
        </form>
      )}
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('toggle-password');
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const eyeIcon = document.getElementById('eye-icon');
      const eyeSlashIcon = document.getElementById('eye-slash-icon');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

      // Toggle visibility
      if (toggleBtn && passwordInput && eyeIcon && eyeSlashIcon) {
        toggleBtn.addEventListener('click', () => {
          const isPassword = passwordInput.type === 'password';
          passwordInput.type = isPassword ? 'text' : 'password';
          
          if (isPassword) {
            eyeIcon.classList.add('hidden');
            eyeSlashIcon.classList.remove('hidden');
          } else {
            eyeIcon.classList.remove('hidden');
            eyeSlashIcon.classList.add('hidden');
          }
        });
      }

      // Password Strength Validation
      if (passwordInput && submitBtn) {
        const dotLength = document.getElementById('dot-length');
        const dotUpper = document.getElementById('dot-upper');
        const dotLower = document.getElementById('dot-lower');
        const dotNumber = document.getElementById('dot-number');
        
        const reqLength = document.getElementById('req-length');
        const reqUpper = document.getElementById('req-upper');
        const reqLower = document.getElementById('req-lower');
        const reqNumber = document.getElementById('req-number');

        passwordInput.addEventListener('input', (e) => {
          const val = (e.target as HTMLInputElement).value;
          
          const hasLength = val.length >= 8;
          const hasUpper = /[A-Z]/.test(val);
          const hasLower = /[a-z]/.test(val);
          const hasNumber = /[0-9]/.test(val);

          // Update colors
          updateReq(hasLength, dotLength, reqLength);
          updateReq(hasUpper, dotUpper, reqUpper);
          updateReq(hasLower, dotLower, reqLower);
          updateReq(hasNumber, dotNumber, reqNumber);

          // Enable/disable submit
          if (hasLength && hasUpper && hasLower && hasNumber) {
            submitBtn.disabled = false;
          } else {
            submitBtn.disabled = true;
          }
        });

        function updateReq(isValid: boolean, dot: HTMLElement | null, textRow: HTMLElement | null) {
          if (!dot || !textRow) return;
          const text = textRow.querySelector('span');
          if (!text) return;

          if (isValid) {
            dot.className = 'w-1 h-1 rounded-full bg-green-500';
            text.className = 'text-green-600';
          } else {
            dot.className = 'w-1 h-1 rounded-full bg-border';
            text.className = 'text-text-muted';
          }
        }
      }
    });
  </script>
</Layout>
