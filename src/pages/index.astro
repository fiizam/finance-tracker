---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome">
  <div class="fixed inset-0 bg-accent flex flex-col items-center justify-center overflow-hidden z-50 transition-opacity duration-500" id="splash">
    <!-- Subtle Parallax Background Elements -->
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-64 h-64 border border-white rounded-full splash-parallax" data-speed="2"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 border border-white rounded-full splash-parallax" data-speed="-1"></div>
    </div>
    
    <div class="relative z-10 flex flex-col items-center animate-fade-in-up">
      <div class="w-16 h-16 bg-white flex items-center justify-center mb-6 rounded-sm shadow-xl transform rotate-3">
        <span class="text-accent font-display font-bold text-3xl leading-none tracking-tighter">F</span>
      </div>
      <h1 class="text-white font-display text-4xl tracking-tight font-medium mb-2">Finance</h1>
      <p class="text-white/70 font-sans text-sm tracking-wide uppercase">Your Money Journal</p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Subtle parallax effect on mouse move
      document.addEventListener('mousemove', (e) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        
        const elements = document.querySelectorAll('.splash-parallax');
        const x = e.clientX / window.innerWidth;
        const y = e.clientY / window.innerHeight;
        
        elements.forEach(el => {
          const speed = parseFloat(el.getAttribute('data-speed') || '1');
          const xOffset = (window.innerWidth / 2 - e.pageX) * (speed / 100);
          const yOffset = (window.innerHeight / 2 - e.pageY) * (speed / 100);
          (el as HTMLElement).style.transform = `translate(${xOffset}px, ${yOffset}px)`;
        });
      });

      // We don't fade out until we actually leave, to prevent white screen
      setTimeout(() => {
        window.location.href = '/app';
      }, 1500);
    });
  </script>

  <style>
    .animate-fade-in-up {
      animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      opacity: 0;
      transform: translateY(20px);
    }
    
    @keyframes fadeInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</Layout>
