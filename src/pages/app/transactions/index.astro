---
import AppLayout from '../../../layouts/AppLayout.astro';
import { db } from '../../../db';
import { transactions, accounts, categories, users } from '../../../db/schema';
import { eq, desc, and, like, sql } from 'drizzle-orm';
import { formatIDR } from '../../../utils/currency';

const userId = Astro.locals.userId;
let error = '';
let success = '';

const currentUser = await db.select({ email: users.email }).from(users).where(eq(users.id, userId)).limit(1);
const isDemo = currentUser[0]?.email === 'demo@example.com';

if (Astro.request.method === 'POST') {
  try {
    if (isDemo) {
      error = 'Tindakan ini diblokir pada akun Demo untuk mencegah kerusakan data.';
    } else {
      const data = await Astro.request.formData();
      const action = data.get('action');
      const txId = data.get('txId')?.toString();

      if (action === 'delete' && txId) {
        const txToDelete = await db.select().from(transactions).where(and(eq(transactions.id, txId), eq(transactions.userId, userId))).limit(1);
        if (txToDelete.length > 0) {
          const tx = txToDelete[0];
          await db.transaction(async (dbTx) => {
            if (tx.type === 'expense') {
              await dbTx.update(accounts).set({ balance: sql`${accounts.balance} + ${tx.amount}` }).where(eq(accounts.id, tx.accountId));
            } else if (tx.type === 'income') {
              await dbTx.update(accounts).set({ balance: sql`${accounts.balance} - ${tx.amount}` }).where(eq(accounts.id, tx.accountId));
            } else if (tx.type === 'transfer' && tx.toAccountId) {
              await dbTx.update(accounts).set({ balance: sql`${accounts.balance} + ${tx.amount}` }).where(eq(accounts.id, tx.accountId));
              await dbTx.update(accounts).set({ balance: sql`${accounts.balance} - ${tx.amount}` }).where(eq(accounts.id, tx.toAccountId));
            }
            await dbTx.delete(transactions).where(eq(transactions.id, tx.id));
          });
          success = 'Transaksi berhasil dihapus dan saldo telah dipulihkan.';
        }
      }
    }
  } catch (e) {
    console.error(e);
    error = 'Terjadi kesalahan saat menghapus transaksi.';
  }
}

// Get filters from URL
const url = new URL(Astro.request.url);
const typeFilter = url.searchParams.get('type');
const search = url.searchParams.get('search');

// Build query
let conditions = [eq(transactions.userId, userId)];
if (typeFilter && typeFilter !== 'all') {
  conditions.push(eq(transactions.type, typeFilter));
}
if (search) {
  conditions.push(like(transactions.description, `%${search}%`));
}

// Fetch transactions with related data
// For simplicity in this mock, we'll fetch them and link in memory if needed, 
// or do a join. A join is better.
const txData = await db
  .select({
    id: transactions.id,
    type: transactions.type,
    amount: transactions.amount,
    date: transactions.date,
    description: transactions.description,
    accountName: accounts.name,
    categoryName: categories.name,
  })
  .from(transactions)
  .leftJoin(accounts, eq(transactions.accountId, accounts.id))
  .leftJoin(categories, eq(transactions.categoryId, categories.id))
  .where(and(...conditions))
  .orderBy(desc(transactions.date))
  .limit(100); // Pagination in real app

// Group by date
const grouped = txData.reduce((acc, tx) => {
  const dateStr = new Date(tx.date).toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
  if (!acc[dateStr]) acc[dateStr] = [];
  acc[dateStr].push(tx);
  return acc;
}, {} as Record<string, typeof txData>);
---

<AppLayout title="Transactions">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-2xl font-display font-medium tracking-tight mb-2">Transactions</h2>
      <p class="text-sm text-text-muted">Your transaction history.</p>
    </div>
    <a href="/app/transactions/new" class="inline-flex bg-accent text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-accent-hover transition-colors">
      Add Transaction
    </a>
  </div>

  <!-- Alerts -->
  {error && (
    <div class="bg-red-50 text-red-700 p-3 rounded-md text-sm border border-red-100 mb-8">
      {error}
    </div>
  )}
  {success && (
    <div class="bg-green-50 text-green-700 p-3 rounded-md text-sm border border-green-100 mb-8">
      {success}
    </div>
  )}

  <!-- Filters -->
  <div class="bg-surface border border-border p-4 rounded-lg mb-8">
    <form method="GET" class="flex flex-wrap gap-4 items-end">
      <div class="space-y-1.5 flex-1 min-w-[200px]">
        <label for="search" class="block text-xs font-medium text-text-muted">Search</label>
        <input 
          type="text" 
          id="search" 
          name="search"
          value={search || ''}
          placeholder="Search descriptions..."
          class="w-full px-3 py-2 bg-transparent border border-border rounded-md focus:outline-none focus:border-text-main text-sm"
        />
      </div>
      
      <div class="space-y-1.5 min-w-[120px]">
        <label for="type" class="block text-xs font-medium text-text-muted">Type</label>
        <select 
          id="type" 
          name="type" 
          class="w-full px-3 py-2 bg-transparent border border-border rounded-md focus:outline-none focus:border-text-main text-sm"
        >
          <option value="all" selected={!typeFilter || typeFilter === 'all'}>All</option>
          <option value="expense" selected={typeFilter === 'expense'}>Expense</option>
          <option value="income" selected={typeFilter === 'income'}>Income</option>
          <option value="transfer" selected={typeFilter === 'transfer'}>Transfer</option>
        </select>
      </div>

      <button type="submit" class="bg-surface-hover text-text-main px-4 py-2 border border-border rounded-md text-sm font-medium hover:bg-border transition-colors">
        Filter
      </button>
    </form>
  </div>

  <!-- Transaction List -->
  <div class="space-y-8">
    {Object.keys(grouped).length === 0 ? (
      <div class="py-12 text-center border border-border border-dashed rounded-lg">
        <p class="text-text-muted text-sm">No transactions found.</p>
      </div>
    ) : (
      Object.keys(grouped).map(dateStr => (
        <section>
          <h3 class="text-sm font-medium text-text-muted mb-4 pb-2 border-b border-border">{dateStr}</h3>
          <div class="space-y-1">
            {grouped[dateStr].map(tx => (
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-4 sm:py-3 px-3 sm:px-2 sm:-mx-2 hover:bg-surface-hover rounded-xl sm:rounded-md transition-colors group gap-3 sm:gap-0 border border-border sm:border-transparent bg-surface sm:bg-transparent">
                <div class="flex flex-col">
                  <span class="text-sm font-medium text-text-main sm:group-hover:text-accent transition-colors">
                    {tx.description || 'Untitled Transaction'}
                  </span>
                  <div class="flex items-center gap-2 mt-1 sm:mt-0.5">
                    <span class="text-xs text-text-muted">{tx.accountName}</span>
                    {tx.categoryName && (
                      <>
                        <span class="text-text-muted text-[10px]">•</span>
                        <span class="text-xs text-text-muted">{tx.categoryName}</span>
                      </>
                    )}
                  </div>
                </div>
                
                <div class="flex flex-row-reverse sm:flex-row items-center justify-between sm:justify-end gap-4">
                  <div class="text-left sm:text-right">
                    <div class:list={[
                      "text-sm font-medium",
                      tx.type === 'expense' ? "text-text-main" : tx.type === 'income' ? "text-green-600" : "text-text-muted"
                    ]}>
                      {tx.type === 'expense' ? '-' : tx.type === 'income' ? '+' : ''}{formatIDR(tx.amount)}
                    </div>
                    {tx.type === 'transfer' && <span class="text-[10px] text-text-muted uppercase tracking-wider block mt-0.5">Transfer</span>}
                  </div>
                  
                  <!-- Actions Container: Always visible as a pill on mobile, fade-in on desktop -->
                  <div class="opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity relative flex justify-end items-center h-10 w-[120px] overflow-hidden">
                    <!-- Default State -->
                    <div class="absolute right-0 flex items-center gap-1 transition-transform duration-300 ease-out translate-x-0 bg-surface-hover sm:bg-transparent p-1 sm:p-0 rounded-lg sm:rounded-none border border-border sm:border-transparent" id={`default-${tx.id}`}>
                      <a href={`/app/transactions/edit/${tx.id}`} class="text-text-muted hover:text-accent p-2 rounded-md hover:bg-surface transition-colors" title="Edit Transaksi">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M227.31,73.37,182.63,28.68a16,16,0,0,0-22.63,0L36.69,152A15.86,15.86,0,0,0,32,163.31V208a16,16,0,0,0,16,16H92.69A15.86,15.86,0,0,0,104,219.31L227.31,96a16,16,0,0,0,0-22.63ZM92.69,208H48V163.31l88-88L180.69,120ZM192,108.68,147.31,64l12.69-12.69,44.69,44.69Z"></path></svg>
                      </a>
                      <div class="w-px h-4 bg-border hidden sm:block"></div>
                      <button type="button" class="text-text-muted hover:text-red-500 p-2 rounded-md hover:bg-red-50 transition-colors btn-intent" data-id={tx.id} title="Hapus Transaksi">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96Zm96,168H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z"></path></svg>
                      </button>
                    </div>
                    
                    <!-- Confirm State -->
                    <div class="absolute right-0 flex items-center gap-2 transition-transform duration-300 ease-out translate-x-[120%] bg-surface-hover sm:bg-transparent p-1 sm:p-0 rounded-lg sm:rounded-none border border-border sm:border-transparent" id={`confirm-${tx.id}`}>
                      <button type="button" class="text-[11px] font-medium text-text-muted hover:text-text-main px-3 py-2 rounded-md hover:bg-surface transition-colors btn-cancel" data-id={tx.id}>Batal</button>
                      <form method="POST" class="m-0 p-0 flex">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="txId" value={tx.id} />
                        <button type="submit" class="text-[11px] font-medium text-white bg-red-500 hover:bg-red-600 px-3 py-2 rounded-md transition-colors shadow-sm active:scale-95">Hapus</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    )}
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.btn-intent').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) {
            const def = document.getElementById(`default-${id}`);
            const conf = document.getElementById(`confirm-${id}`);
            if (def && conf) {
              def.classList.remove('translate-x-0');
              def.classList.add('translate-x-[120%]');
              conf.classList.remove('translate-x-[120%]');
              conf.classList.add('translate-x-0');
            }
          }
        });
      });

      document.querySelectorAll('.btn-cancel').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) {
            const def = document.getElementById(`default-${id}`);
            const conf = document.getElementById(`confirm-${id}`);
            if (def && conf) {
              def.classList.remove('translate-x-[120%]');
              def.classList.add('translate-x-0');
              conf.classList.remove('translate-x-0');
              conf.classList.add('translate-x-[120%]');
            }
          }
        });
      });
    });
  </script>
</AppLayout>
