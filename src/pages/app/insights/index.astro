---
import AppLayout from '../../../layouts/AppLayout.astro';
import { db } from '../../../db';
import { transactions, categories } from '../../../db/schema';
import { eq, and, gte, sql } from 'drizzle-orm';
import { formatIDR } from '../../../utils/currency';

const userId = Astro.locals.userId;

// Current month calculations
const startOfMonth = new Date();
startOfMonth.setDate(1);
startOfMonth.setHours(0, 0, 0, 0);

const monthTx = await db
  .select({
    amount: transactions.amount,
    type: transactions.type,
    categoryName: categories.name,
  })
  .from(transactions)
  .leftJoin(categories, eq(transactions.categoryId, categories.id))
  .where(
    and(
      eq(transactions.userId, userId),
      gte(transactions.date, startOfMonth)
    )
  );

let monthlyIncome = 0;
let monthlyExpense = 0;
const spendingByCategory: Record<string, number> = {};

monthTx.forEach(tx => {
  if (tx.type === 'income') monthlyIncome += tx.amount;
  if (tx.type === 'expense') {
    monthlyExpense += tx.amount;
    const cat = tx.categoryName || 'Uncategorized';
    if (!spendingByCategory[cat]) spendingByCategory[cat] = 0;
    spendingByCategory[cat] += tx.amount;
  }
});

const sortedCategories = Object.entries(spendingByCategory)
  .sort((a, b) => b[1] - a[1]);

const maxCategoryAmount = sortedCategories.length > 0 ? sortedCategories[0][1] : 0;
const totalFlow = monthlyIncome + monthlyExpense;
const incomePercent = totalFlow > 0 ? (monthlyIncome / totalFlow) * 100 : 0;
const expensePercent = totalFlow > 0 ? (monthlyExpense / totalFlow) * 100 : 0;
---

<AppLayout title="Insights">
  <div class="mb-10">
    <h2 class="text-2xl font-display font-medium tracking-tight mb-2">Insights</h2>
    <p class="text-sm text-text-muted">Analyze your spending habits for the current month.</p>
  </div>

  <div class="space-y-12">
    <!-- Income vs Expense Bar -->
    <section>
      <h3 class="text-sm font-medium text-text-muted mb-4">Income vs Expense</h3>
      <div class="bg-surface border border-border rounded-lg p-6 shadow-sm">
        <div class="flex justify-between mb-2">
          <div>
            <p class="text-xs text-text-muted">Income</p>
            <p class="text-sm font-medium text-green-600">{formatIDR(monthlyIncome)}</p>
          </div>
          <div class="text-right">
            <p class="text-xs text-text-muted">Expense</p>
            <p class="text-sm font-medium text-text-main">{formatIDR(monthlyExpense)}</p>
          </div>
        </div>
        
        <!-- Lightweight CSS Bar Chart -->
        <div class="w-full h-3 bg-surface-hover rounded-full overflow-hidden flex">
          <div class="h-full bg-green-500 transition-all duration-1000 ease-out" style={`width: ${incomePercent}%`}></div>
          <div class="h-full bg-accent transition-all duration-1000 ease-out" style={`width: ${expensePercent}%`}></div>
        </div>
      </div>
    </section>

    <!-- Spending by Category -->
    <section>
      <h3 class="text-sm font-medium text-text-muted mb-4">Spending by Category</h3>
      
      {sortedCategories.length === 0 ? (
        <div class="py-12 text-center border border-border border-dashed rounded-lg">
          <p class="text-text-muted text-sm">No expenses this month yet.</p>
        </div>
      ) : (
        <div class="bg-surface border border-border rounded-lg p-6 shadow-sm space-y-5">
          {sortedCategories.map(([category, amount]) => {
            const percent = maxCategoryAmount > 0 ? (amount / maxCategoryAmount) * 100 : 0;
            return (
              <div>
                <div class="flex justify-between text-sm mb-1">
                  <span class="font-medium text-text-main">{category}</span>
                  <span class="text-text-main">{formatIDR(amount)}</span>
                </div>
                <div class="w-full h-1.5 bg-surface-hover rounded-full overflow-hidden">
                  <div class="h-full bg-accent transition-all duration-1000 ease-out" style={`width: ${percent}%`}></div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>
  </div>
</AppLayout>
