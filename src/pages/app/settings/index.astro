---
import AppLayout from '../../../layouts/AppLayout.astro';
import { db } from '../../../db';
import { categories, users, transactions } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { SignOut, Tag, User, Palette, CurrencyCircleDollar, DownloadSimple, Check, Moon, Sun } from 'phosphor-svelte';

const userId = Astro.locals.userId;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action')?.toString();

  if (action === 'logout') {
    Astro.cookies.delete('session', { path: '/' });
    return Astro.redirect('/login');
  } else if (action === 'addCategory') {
    const name = data.get('name')?.toString();
    const type = data.get('type')?.toString();
    
    if (name && type) {
      await db.insert(categories).values({ userId, name, type });
      return Astro.redirect('/app/settings');
    }
  } else if (action === 'setCurrency') {
    const currency = data.get('currency')?.toString();
    if (currency) {
      Astro.cookies.set('currency', currency, { path: '/' });
      return Astro.redirect('/app/settings');
    }
  } else if (action === 'export') {
    const allTx = await db.select({
      date: transactions.date,
      type: transactions.type,
      amount: transactions.amount,
      description: transactions.description,
    }).from(transactions).where(eq(transactions.userId, userId)).orderBy(desc(transactions.date));
    
    let csv = 'Date,Type,Amount,Description\n';
    allTx.forEach(t => {
      const d = new Date(t.date).toISOString().split('T')[0];
      const descText = t.description ? t.description.replace(/,/g, '') : '';
      csv += `${d},${t.type},${t.amount},${descText}\n`;
    });
    
    return new Response(csv, {
      status: 200,
      headers: {
        'Content-Type': 'text/csv',
        'Content-Disposition': 'attachment; filename="finance_transactions.csv"'
      }
    });
  }
}

const userCurrency = Astro.cookies.get('currency')?.value || 'IDR';
const userCategories = await db.select().from(categories).where(eq(categories.userId, userId));
const currentUser = await db.select().from(users).where(eq(users.id, userId)).limit(1);
---

<AppLayout title="Settings">
  <div class="max-w-2xl mx-auto pb-12">
    <div class="mb-10">
      <h2 class="text-3xl font-display font-medium tracking-tight mb-2">Settings</h2>
      <p class="text-sm text-text-muted">Manage your profile, preferences, and security.</p>
    </div>

    <div class="space-y-10">
      <!-- Profile Section -->
      <section>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3 px-1">Profile</h3>
        <div class="bg-surface border border-border rounded-2xl p-5 sm:p-6 flex items-center justify-between shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)] transition-all hover:shadow-md">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-surface-hover to-border flex items-center justify-center text-text-muted border border-border/50">
              <User size={28} weight="duotone" />
            </div>
            <div>
              <p class="font-medium text-lg text-text-main leading-tight">{currentUser[0]?.name || 'User'}</p>
              <p class="text-sm text-text-muted mt-0.5">{currentUser[0]?.email || ''}</p>
            </div>
          </div>
          <span class="px-3 py-1 bg-green-50 text-green-700 text-[10px] font-bold uppercase tracking-wider rounded-full border border-green-200">Active</span>
        </div>
      </section>

      <!-- Preferences Section -->
      <section>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3 px-1">Preferences</h3>
        <div class="bg-surface border border-border rounded-2xl divide-y divide-border flex flex-col shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)]">
          <button type="button" id="theme-toggle" class="w-full flex items-center justify-between p-4 sm:px-6 sm:py-5 hover:bg-surface-hover transition-colors group first:rounded-t-2xl">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-surface-hover flex items-center justify-center text-text-main group-hover:scale-110 transition-transform duration-300">
                <Palette size={20} />
              </div>
              <div class="text-left">
                <p class="text-sm font-medium text-text-main">Appearance</p>
                <p class="text-xs text-text-muted mt-0.5">Toggle light or dark theme</p>
              </div>
            </div>
            
            <!-- Animated Theme Toggle -->
            <div class="relative w-14 h-8 rounded-full border border-border p-1 transition-colors duration-500" id="theme-track">
              <div class="absolute inset-0 flex justify-between items-center px-1.5 pointer-events-none">
                <Moon size={14} class="text-text-muted opacity-50" />
                <Sun size={14} class="text-text-muted opacity-50" />
              </div>
              <div class="w-6 h-6 rounded-full shadow-sm relative z-10 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]" id="theme-thumb">
                <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-accent-hover to-accent opacity-0 transition-opacity duration-300" id="theme-thumb-dark"></div>
                <div class="absolute inset-0 rounded-full bg-white transition-opacity duration-300 shadow-[0_2px_4px_rgba(0,0,0,0.1)]" id="theme-thumb-light"></div>
              </div>
            </div>
          </button>
          
          <div class="relative w-full action-menu-container">
            <button type="button" class="w-full flex items-center justify-between p-4 sm:px-6 sm:py-5 hover:bg-surface-hover transition-colors group btn-action-toggle last:rounded-b-2xl" data-target="currency-menu">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-surface-hover flex items-center justify-center text-text-main group-hover:scale-110 transition-transform duration-300">
                  <CurrencyCircleDollar size={20} />
                </div>
                <div class="text-left">
                  <p class="text-sm font-medium text-text-main">Currency</p>
                  <p class="text-xs text-text-muted mt-0.5">Change your default currency</p>
                </div>
              </div>
              <span class="text-sm font-medium text-text-muted bg-surface-hover px-2 py-1 rounded border border-border">{userCurrency}</span>
            </button>
            
            <!-- Floating Custom Dropdown -->
            <div id="currency-menu" class="absolute right-6 top-16 bg-surface border border-border shadow-[0_10px_30px_-5px_rgba(0,0,0,0.15)] rounded-xl flex flex-col p-1.5 gap-1 z-20 opacity-0 pointer-events-none scale-95 transition-all duration-200 origin-top-right min-w-[150px]">
              {['IDR', 'USD', 'EUR'].map((curr) => (
                <form method="POST" class="m-0">
                  <input type="hidden" name="action" value="setCurrency" />
                  <input type="hidden" name="currency" value={curr} />
                  <button type="submit" class="w-full flex items-center justify-between px-3 py-2 text-sm font-medium rounded-lg transition-colors hover:bg-surface-hover">
                    <span class={userCurrency === curr ? "text-text-main" : "text-text-muted"}>
                      {curr === 'IDR' ? 'IDR (Rp)' : curr === 'USD' ? 'USD ($)' : 'EUR (€)'}
                    </span>
                    {userCurrency === curr && (
                      <div class="w-1.5 h-1.5 rounded-full bg-accent"></div>
                    )}
                  </button>
                </form>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Categories Section -->
      <section>
        <h3 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3 px-1">Manage Categories</h3>
        <div class="bg-surface border border-border rounded-2xl shadow-[0_2px_10px_-4px_rgba(0,0,0,0.05)] overflow-hidden">
          <div class="p-2 max-h-[280px] overflow-y-auto custom-scrollbar">
            {userCategories.length === 0 ? (
              <p class="text-sm text-text-muted text-center py-6">No custom categories yet.</p>
            ) : (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {userCategories.map(cat => (
                  <div class="flex items-center justify-between p-3 border border-border/50 rounded-xl hover:bg-surface-hover transition-colors">
                    <div class="flex items-center gap-3">
                      <div class="text-border">
                        <Tag size={16} />
                      </div>
                      <span class="text-sm font-medium text-text-main">{cat.name}</span>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 bg-surface-hover rounded-md text-text-muted">{cat.type}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
          
          <!-- Add Category Form -->
          <div class="p-4 sm:p-5 border-t border-border bg-surface-hover/30">
            <form method="POST" class="flex flex-col sm:flex-row gap-3">
              <input type="hidden" name="action" value="addCategory" />
              <div class="flex-1">
                <input type="text" name="name" placeholder="E.g. Groceries" required class="w-full px-4 py-2.5 bg-surface border border-border rounded-xl text-sm focus:outline-none focus:border-text-main focus:ring-1 focus:ring-text-main transition-all" />
              </div>
              <div class="flex gap-3">
                <select name="type" required class="px-3 py-2.5 bg-surface border border-border rounded-xl text-sm focus:outline-none focus:border-text-main transition-all appearance-none cursor-pointer min-w-[110px]">
                  <option value="expense">Expense</option>
                  <option value="income">Income</option>
                </select>
                <button type="submit" class="bg-accent text-white px-5 py-2.5 rounded-xl text-sm font-medium transition-all hover:bg-accent-hover hover:scale-105 active:scale-95 shadow-sm whitespace-nowrap">
                  Add New
                </button>
              </div>
            </form>
          </div>
        </div>
      </section>

      <!-- Danger Zone -->
      <section>
        <h3 class="text-xs font-semibold text-red-500 uppercase tracking-wider mb-3 px-1">Danger Zone</h3>
        <div class="bg-surface border border-red-100 rounded-2xl divide-y divide-border overflow-hidden shadow-[0_2px_10px_-4px_rgba(255,0,0,0.05)]">
          <form method="POST" class="w-full m-0 p-0" onsubmit="return confirm('Download all your transactions?')">
            <input type="hidden" name="action" value="export" />
            <button type="submit" class="w-full flex items-center justify-between p-4 sm:px-6 sm:py-5 hover:bg-surface-hover transition-colors group">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-surface-hover flex items-center justify-center text-text-main group-hover:text-accent transition-colors">
                  <DownloadSimple size={20} />
                </div>
                <div class="text-left">
                  <p class="text-sm font-medium text-text-main group-hover:text-accent transition-colors">Export Data</p>
                  <p class="text-xs text-text-muted mt-0.5">Download all transactions as CSV</p>
                </div>
              </div>
            </button>
          </form>
          
          <form method="POST" class="w-full m-0 p-0">
            <input type="hidden" name="action" value="logout" />
            <button type="submit" class="w-full flex items-center justify-between p-4 sm:px-6 sm:py-5 hover:bg-red-50 transition-colors group">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center text-red-500 group-hover:bg-red-100 group-hover:scale-110 transition-all">
                  <SignOut size={20} />
                </div>
                <div class="text-left">
                  <p class="text-sm font-medium text-red-600">Sign Out</p>
                  <p class="text-xs text-red-400 mt-0.5">End your current session securely</p>
                </div>
              </div>
            </button>
          </form>
        </div>
      </section>
    </div>
  </div>
  
  <style>
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background-color: var(--border);
      border-radius: 20px;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const themeToggle = document.getElementById('theme-toggle');
      const themeTrack = document.getElementById('theme-track');
      const themeThumb = document.getElementById('theme-thumb');
      const thumbDark = document.getElementById('theme-thumb-dark');
      const thumbLight = document.getElementById('theme-thumb-light');

      const updateUI = (isDark: boolean) => {
        if (isDark) {
          themeTrack?.classList.add('bg-surface-hover', 'border-border');
          themeTrack?.classList.remove('bg-surface', 'border-border');
          themeThumb?.classList.add('translate-x-6');
          thumbDark?.classList.remove('opacity-0');
          thumbLight?.classList.add('opacity-0');
        } else {
          themeTrack?.classList.remove('bg-surface-hover');
          themeTrack?.classList.add('bg-surface');
          themeThumb?.classList.remove('translate-x-6');
          thumbDark?.classList.add('opacity-0');
          thumbLight?.classList.remove('opacity-0');
        }
      };

      // Initial state
      const isDark = document.documentElement.classList.contains('dark');
      updateUI(isDark);

      themeToggle?.addEventListener('click', (event) => {
        event.preventDefault();
        const isDarkNow = document.documentElement.classList.contains('dark');
        
        const toggleTheme = () => {
          if (isDarkNow) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
            updateUI(false);
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
            updateUI(true);
          }
        };

        // Fallback for browsers that don't support View Transitions
        if (!document.startViewTransition) {
          toggleTheme();
          return;
        }

        // Set click coordinates as CSS variables for the keyframe animation
        const x = (event as MouseEvent).clientX;
        const y = (event as MouseEvent).clientY;
        const r = Math.hypot(
          Math.max(x, innerWidth - x),
          Math.max(y, innerHeight - y)
        );

        document.documentElement.style.setProperty('--click-x', `${x}px`);
        document.documentElement.style.setProperty('--click-y', `${y}px`);
        document.documentElement.style.setProperty('--click-r', `${r}px`);

        document.startViewTransition(() => {
          toggleTheme();
        });
      });

      // Dropdown logic
      const toggles = document.querySelectorAll('.btn-action-toggle');
      let activeMenu: HTMLElement | null = null;

      toggles.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const targetId = (btn as HTMLElement).getAttribute('data-target');
          if (!targetId) return;
          const menu = document.getElementById(targetId);
          
          if (activeMenu && activeMenu !== menu) {
            activeMenu.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
            activeMenu.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
          }

          if (menu) {
            const isOpen = menu.classList.contains('opacity-100');
            if (isOpen) {
              menu.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
              menu.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
              activeMenu = null;
            } else {
              menu.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
              menu.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
              activeMenu = menu;
            }
          }
        });
      });

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (activeMenu && !target.closest('.action-menu-container')) {
          activeMenu.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
          activeMenu.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
          activeMenu = null;
        }
      });
    });
  </script>
</AppLayout>
