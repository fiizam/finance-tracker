---
import AppLayout from '../../../layouts/AppLayout.astro';
import { db } from '../../../db';
import { accounts, users } from '../../../db/schema';
import { eq, sql } from 'drizzle-orm';
import { formatIDR } from '../../../utils/currency';
import { Plus, Bank, Wallet, CreditCard, Coins, DotsThree } from 'phosphor-svelte';

const userId = Astro.locals.userId;

const currentUser = await db.select({ email: users.email }).from(users).where(eq(users.id, userId)).limit(1);
const isDemo = currentUser[0]?.email === 'demo@example.com';

// Handle create account
let error = '';
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action')?.toString();

    if ((action === 'delete' || action === 'updateBalance') && isDemo) {
      error = 'Tindakan ini diblokir pada akun Demo untuk mencegah kerusakan data.';
    } else if (action === 'create') {
      const name = data.get('name')?.toString();
      const type = data.get('type')?.toString();
      const balanceStr = data.get('balance')?.toString() || '0';
      const balance = parseInt(balanceStr.replace(/\./g, ''), 10);
      
      if (name && type) {
        await db.insert(accounts).values({
          userId,
          name,
          type,
          balance,
        });
        return Astro.redirect('/app/accounts');
      } else {
        error = 'Missing required fields.';
      }
    } else if (action === 'updateBalance') {
      const accountId = data.get('accountId')?.toString();
      const balanceStr = data.get('balance')?.toString() || '0';
      const balance = parseInt(balanceStr.replace(/\./g, ''), 10);
      
      if (accountId) {
        await db.update(accounts).set({ balance }).where(eq(accounts.id, accountId));
        return Astro.redirect('/app/accounts');
      }
    } else if (action === 'delete') {
      const accountId = data.get('accountId')?.toString();
      if (accountId) {
        // Warning: in a real app, deleting an account should also handle related transactions.
        // For simplicity, we just delete the account.
        await db.delete(accounts).where(eq(accounts.id, accountId));
        return Astro.redirect('/app/accounts');
      }
    }
  } catch (e) {
    error = 'An error occurred while managing accounts.';
  }
}

const userAccounts = await db.select().from(accounts).where(eq(accounts.userId, userId));
const totalBalance = userAccounts.reduce((sum, acc) => sum + acc.balance, 0);

const getIconForType = (type: string) => {
  switch(type) {
    case 'bank': return Bank;
    case 'digital_bank': return CreditCard;
    case 'e_wallet': return Wallet;
    case 'cash': return Coins;
    default: return Wallet;
  }
}
---

<AppLayout title="Accounts">
  <div class="mb-10">
    <h2 class="text-2xl font-display font-medium tracking-tight mb-2">Accounts</h2>
    <p class="text-sm text-text-muted">Manage your bank accounts, e-wallets, and cash.</p>
  </div>

  <div class="mb-12">
    <p class="text-sm text-text-muted mb-1">Total across accounts</p>
    <h3 class="text-3xl font-display font-medium text-text-main">{formatIDR(totalBalance)}</h3>
  </div>

  {error && (
    <div class="bg-red-50 text-red-700 p-3 rounded-md text-sm border border-red-100 mb-6">
      {error}
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
    {userAccounts.map(acc => {
      const Icon = getIconForType(acc.type);
      return (
        <div class="bg-surface border border-border rounded-lg p-5 shadow-sm relative group transition-colors hover:border-text-muted/30">
          <div class="flex items-start justify-between mb-8">
            <div class="w-10 h-10 rounded-full bg-surface-hover flex items-center justify-center text-text-main">
              <Icon size={20} />
            </div>
            
            <div class="flex items-center gap-2">
              <form method="POST" onsubmit="return confirm('Are you sure you want to delete this account?');">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="accountId" value={acc.id} />
                <button type="submit" class="text-text-muted hover:text-red-500 p-1 transition-colors" title="Delete Account">
                  <span class="sr-only">Delete</span>
                  <svg xmlns="http://www.w3.org/-2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96Zm96,168H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z"></path></svg>
                </button>
              </form>
            </div>
          </div>
          <div>
            <p class="text-xs text-text-muted capitalize mb-1">{acc.type.replace('_', ' ')}</p>
            <p class="text-sm font-medium text-text-main mb-3">{acc.name}</p>
            
            <form method="POST" class="flex items-center gap-2 mt-2">
              <input type="hidden" name="action" value="updateBalance" />
              <input type="hidden" name="accountId" value={acc.id} />
              <div class="relative flex-1">
                <span class="absolute left-2 top-1/2 -translate-y-1/2 text-text-muted text-xs">Rp</span>
                <input type="text" inputmode="numeric" name="balance" value={new Intl.NumberFormat('id-ID').format(acc.balance)} required class="format-idr-input w-full pl-7 pr-2 py-1 bg-transparent border border-border rounded text-sm font-display font-medium text-text-main focus:outline-none focus:border-text-main" />
              </div>
              <button type="submit" class="bg-surface-hover text-text-main px-2 py-1 border border-border rounded text-xs font-medium hover:bg-border transition-colors">
                Save
              </button>
            </form>
          </div>
        </div>
      );
    })}

    <!-- Add Account Form / Button -->
    <div class="bg-surface border border-border border-dashed rounded-lg p-5 shadow-sm flex flex-col justify-center">
      <form method="POST" class="space-y-4">
        <input type="hidden" name="action" value="create" />
        <div class="space-y-1.5">
          <input type="text" name="name" placeholder="Account Name (e.g. BCA, GoPay)" required class="w-full px-3 py-2 bg-transparent border border-border rounded-md text-sm" />
        </div>
        <div class="space-y-1.5">
          <select name="type" required class="w-full px-3 py-2 bg-transparent border border-border rounded-md text-sm capitalize">
            <option value="bank">Bank</option>
            <option value="digital_bank">Digital Bank</option>
            <option value="e_wallet">E-Wallet</option>
            <option value="cash">Cash</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="space-y-1.5">
          <input type="text" inputmode="numeric" name="balance" placeholder="Starting Balance (Rp)" class="format-idr-input w-full px-3 py-2 bg-transparent border border-border rounded-md text-sm" />
        </div>
        <button type="submit" class="w-full flex items-center justify-center gap-2 bg-surface-hover text-text-main px-4 py-2 rounded-md text-sm font-medium transition-colors hover:bg-border">
          <Plus size={16} /> Add Account
        </button>
      </form>
    </div>
  </div>
</AppLayout>
