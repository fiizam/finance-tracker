---
import Layout from '../layouts/Layout.astro';
import { db } from '../db';
import { users } from '../db/schema';
import { eq } from 'drizzle-orm';

let error = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const email = data.get('email')?.toString();

    if (!email) {
      error = 'Please provide your email address.';
    } else {
      const userResult = await db.select().from(users).where(eq(users.email, email)).limit(1);
      const user = userResult[0];

      if (!user) {
        // We show the same generic success message to prevent email enumeration attacks
        return Astro.redirect('/reset-password?email=' + encodeURIComponent(email));
      }

      // Generate 6-digit OTP
      const otp = Math.floor(100000 + Math.random() * 900000).toString();
      
      await db.update(users).set({ 
        verificationCode: otp 
      }).where(eq(users.id, user.id));

      const { sendResetPasswordEmail } = await import('../utils/email');
      try {
        await sendResetPasswordEmail(email, otp);
      } catch (emailErr) {
        console.error("Failed to send reset email:", emailErr);
      }

      return Astro.redirect('/reset-password?email=' + encodeURIComponent(email));
    }
  } catch (e: any) {
    console.error('Forgot password error:', e);
    error = 'Something went wrong. Please try again.';
  }
}
---

<Layout title="Forgot Password">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 page-transition">
    <div class="w-full max-w-sm">
      <div class="mb-12">
        <div class="w-10 h-10 rounded-sm bg-accent flex items-center justify-center mb-6">
          <span class="text-white font-display font-semibold text-lg leading-none tracking-tight">F</span>
        </div>
        <h1 class="text-3xl font-display font-medium text-text-main mb-2 tracking-tight">Reset Password</h1>
        <p class="text-text-muted text-sm">Enter your email and we'll send you a verification code.</p>
      </div>

      <form method="POST" class="space-y-6">
        {error && (
          <div class="bg-red-50 text-red-700 p-3 rounded-md text-sm border border-red-100">
            {error}
          </div>
        )}
        
        <div class="space-y-4">
          <div class="space-y-1.5">
            <label for="email" class="block text-sm font-medium text-text-main">Email</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              class="w-full px-3 py-2 bg-transparent border border-border rounded-md focus:outline-none focus:border-text-main focus:ring-1 focus:ring-text-main transition-colors text-sm"
            />
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full bg-accent text-white rounded-md py-2.5 text-sm font-medium hover:bg-accent-hover transition-colors shadow-sm active:scale-[0.98]"
        >
          Send Code
        </button>
      </form>

      <div class="mt-8 text-center">
        <p class="text-sm text-text-muted">
          Remember your password? <a href="/login" class="text-text-main font-medium hover:underline">Sign in</a>
        </p>
      </div>
    </div>
  </main>
</Layout>
