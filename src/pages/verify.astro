---
import Layout from '../layouts/Layout.astro';
import { db } from '../db';
import { users } from '../db/schema';
import { eq } from 'drizzle-orm';
import { createSessionToken } from '../utils/auth';

let error = '';
const emailParam = Astro.url.searchParams.get('email') || '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const email = data.get('email')?.toString();
    const otp = data.get('otp')?.toString();

    if (!email || !otp) {
      error = 'Please provide both email and OTP.';
    } else {
      const userResult = await db.select().from(users).where(eq(users.email, email)).limit(1);
      const user = userResult[0];

      if (!user) {
        error = 'User not found.';
      } else if (user.isVerified) {
        error = 'Account is already verified. Please log in.';
      } else if (user.verificationCode !== otp) {
        error = 'Invalid verification code.';
      } else {
        // Mark as verified
        await db.update(users).set({ 
          isVerified: true, 
          verificationCode: null 
        }).where(eq(users.id, user.id));

        // Log them in
        const token = await createSessionToken(user.id);
        Astro.cookies.set('session', token, { path: '/', httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD });
        return Astro.redirect('/app');
      }
    }
  } catch (e: any) {
    console.error('Verify error:', e);
    error = 'Something went wrong. Please try again.';
  }
}
---

<Layout title="Verify Account">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 page-transition">
    <div class="w-full max-w-sm">
      <div class="mb-12">
        <div class="w-10 h-10 rounded-sm bg-accent flex items-center justify-center mb-6">
          <span class="text-white font-display font-semibold text-lg leading-none tracking-tight">F</span>
        </div>
        <h1 class="text-3xl font-display font-medium text-text-main mb-2 tracking-tight">Verify your email</h1>
        <p class="text-text-muted text-sm">We've sent a 6-digit code to your email.</p>
      </div>

      <form method="POST" class="space-y-6">
        <input type="hidden" name="email" value={emailParam} />
        
        {error && (
          <div class="bg-red-50 text-red-700 p-3 rounded-md text-sm border border-red-100">
            {error}
          </div>
        )}
        
        <div class="space-y-4">
          <div class="space-y-1.5">
            <label for="otp" class="block text-sm font-medium text-text-main">6-Digit Code</label>
            <input 
              type="text" 
              inputmode="numeric"
              pattern="[0-9]{6}"
              maxlength="6"
              id="otp" 
              name="otp" 
              placeholder="123456"
              required 
              class="w-full px-3 py-3 bg-transparent border border-border rounded-md focus:outline-none focus:border-text-main focus:ring-1 focus:ring-text-main transition-colors text-center text-xl tracking-[0.5em] font-display font-medium text-text-main"
            />
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full bg-accent text-white rounded-md py-2.5 text-sm font-medium hover:bg-accent-hover transition-colors shadow-sm active:scale-[0.98]"
        >
          Verify & Continue
        </button>
      </form>

      <div class="mt-8 text-center">
        <p class="text-sm text-text-muted">
          Didn't receive the email? <a href="/login" class="text-text-main font-medium hover:underline">Try logging in</a>
        </p>
      </div>
    </div>
  </main>
</Layout>
