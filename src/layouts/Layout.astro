---
import '../styles/global.css';
import TopProgressBar from '../components/TopProgressBar.astro';
import MobileAppSplash from '../components/MobileAppSplash.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal finance companion.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#04471C" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Finance" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- iPhone Launch Splash Screens (Exact Resolution Match for iOS WebKit) -->
    <!-- iPhone 16 Pro Max (440x956 @3x -> 1320x2868) -->
    <link rel="apple-touch-startup-image" media="(device-width: 440px) and (device-height: 956px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-splash-1320x2868.png" />
    <!-- iPhone 16 Pro (402x874 @3x -> 1206x2622) -->
    <link rel="apple-touch-startup-image" media="(device-width: 402px) and (device-height: 874px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-splash-1206x2622.png" />
    <!-- iPhone 14 Pro Max, 15 Plus, 15 Pro Max, 16 Plus (430x932 @3x -> 1290x2796) -->
    <link rel="apple-touch-startup-image" media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-splash-1290x2796.png" />
    <!-- iPhone 14 Pro, 15, 15 Pro (393x852 @3x -> 1179x2556) -->
    <link rel="apple-touch-startup-image" media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-splash-1179x2556.png" />
    <!-- iPhone 12, 12 Pro, 13, 13 Pro, 14 (390x844 @3x -> 1170x2532) -->
    <link rel="apple-touch-startup-image" media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-splash-1170x2532.png" />
    <!-- iPhone 12 Pro Max, 13 Pro Max, 14 Plus (428x926 @3x -> 1284x2778) -->
    <link rel="apple-touch-startup-image" media="(device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-splash-1284x2778.png" />
    <!-- iPhone 11 Pro, XS, X (375x812 @3x -> 1125x2436) -->
    <link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-splash-1125x2436.png" />
    <!-- iPhone 11, XR (414x896 @2x -> 828x1792) -->
    <link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href="/apple-splash-828x1792.png" />
    <!-- iPhone 11 Pro Max, XS Max (414x896 @3x -> 1242x2688) -->
    <link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href="/apple-splash-1242x2688.png" />
    <!-- iPhone 7, 8, SE (375x667 @2x -> 750x1334) -->
    <link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href="/apple-splash-750x1334.png" />
    <!-- Universal fallback -->
    <link rel="apple-touch-startup-image" href="/apple-splash.png" />
    <link rel="apple-touch-startup-image" href="/apple-splash-1179x2556.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
    <title>{title}</title>
  </head>
  <body class="bg-background text-text-main antialiased min-h-screen page-transition">
    <MobileAppSplash />
    <TopProgressBar />
    <slot />
    
    <script>
      // Automatically format inputs with the class 'format-idr-input'
      document.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        if (target && target.classList && target.classList.contains('format-idr-input')) {
          // Store cursor position to restore it after formatting
          const cursorPosition = target.selectionStart || 0;
          const oldLength = target.value.length;
          
          let val = target.value.replace(/\D/g, '');
          if (val) {
            target.value = new Intl.NumberFormat('id-ID').format(parseInt(val, 10));
          } else {
            target.value = '';
          }
          
          // Adjust cursor position based on added/removed periods
          const newLength = target.value.length;
          const diff = newLength - oldLength;
          const newPosition = Math.max(0, cursorPosition + diff);
          target.setSelectionRange(newPosition, newPosition);
        }
      });
    </script>
  </body>
</html>
