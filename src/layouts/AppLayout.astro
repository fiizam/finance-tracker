---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={`${title} | Finance`}>
  <div class="flex h-screen overflow-hidden bg-background">
    <!-- Desktop Sidebar -->
    <aside class="hidden md:flex w-64 flex-col border-r border-border bg-surface">
      <Sidebar />
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto pb-16 md:pb-0 page-transition">
      <header class="h-16 border-b border-border bg-surface/80 backdrop-blur-md sticky top-0 z-10 flex items-center px-6 md:px-10">
        <h1 class="text-xl font-display text-text-main">{title}</h1>
      </header>
      
      <div class="px-6 md:px-10 py-8 max-w-5xl mx-auto">
        <slot />
      </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <MobileNav />
  </div>
</Layout>
